# Local API configuration
TRUE_EYE_DB=./attendance.db
TRUE_EYE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUE_EYE_ATTENDANCE_THRESHOLD=75
# Gmail SMTP: use a Google App Password (not your regular Gmail password).
TRUE_EYE_GMAIL_ADDRESS=your-account@gmail.com
TRUE_EYE_GMAIL_APP_PASSWORD=your-16-character-app-password
# Set VITE_API_URL in web/.env.local to http://127.0.0.1:8000
# Keep this threshold aligned with VITE_ATTENDANCE_THRESHOLD in web/.env.local.
